# Copia in .env.local (dev) oppure configura le stesse chiavi su Vercel → Settings → Environment Variables.
# Non inserire service account, password o chiavi amministrative.

# --- Firebase Web (obbligatorie per login) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=magazzino-mp
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Sorgente magazzino (default sicuro: IndexedDB) ---
# Cloud su Spark: abilitare senza Blaze / senza Callable (vedi docs/spark-senza-blaze.md).
VITE_CLOUD_WAREHOUSE_ENABLED=false
VITE_DATA_SOURCE=indexeddb

# --- Callable Firebase (opzionale, richiede Blaze) ---
# Default false = percorso Spark con transazioni client.
# true solo se Functions sono deployate su Blaze e vuoi garanzia Admin server-side.
VITE_USE_STOCK_CALLABLE=false

# Solo sviluppo locale con Emulator Functions (non usare in Vercel Production):
# VITE_FUNCTIONS_EMULATOR=true

# =============================================================================
# Checklist variabili Vercel (Production / Preview)
# =============================================================================
# Sempre:
#   VITE_FIREBASE_API_KEY
#   VITE_FIREBASE_AUTH_DOMAIN
#   VITE_FIREBASE_PROJECT_ID
#   VITE_FIREBASE_STORAGE_BUCKET
#   VITE_FIREBASE_MESSAGING_SENDER_ID
#   VITE_FIREBASE_APP_ID
#   VITE_CLOUD_WAREHOUSE_ENABLED          (=false finché non si attiva il cloud)
#   VITE_DATA_SOURCE                     (=indexeddb finché non si attiva il cloud)
#   VITE_USE_STOCK_CALLABLE              (=false percorso Spark)
#
# Dopo attivazione cloud Spark (manuale, zero Blaze):
#   VITE_CLOUD_WAREHOUSE_ENABLED=true
#   VITE_USE_STOCK_CALLABLE=false
#   VITE_DATA_SOURCE=firestore           (oppure lasciare indexeddb e switch admin in UI)
#   + pubblicare firestore.rules.cloud-warehouse.proposal
#
# Opzionale Blaze (non necessario):
#   VITE_USE_STOCK_CALLABLE=true + Functions deployate
#
# Non impostare su Vercel:
#   VITE_FUNCTIONS_EMULATOR
# =============================================================================
