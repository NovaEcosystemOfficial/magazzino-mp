# Copia in .env.local e valorizza con la config dell'app Web Firebase (Console → Impostazioni progetto).
# Non inserire service account o chiavi amministrative.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=magazzino-mp
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
