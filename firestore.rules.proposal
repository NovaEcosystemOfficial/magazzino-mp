rules_version = '2';
// PROPOSTA fase login — NON DISTRIBUITA AUTOMATICAMENTE da questa repo.
// Da revisionare e pubblicare manualmente dalla Console Firebase o con deploy esplicito.
//
// Obiettivo fase login: profilo utente leggibile solo dal proprietario; nessun accesso pubblico;
// nessun self-elevate a admin; brands/** chiuso (magazzino resta IndexedDB).
//
// Bozza rules per il futuro magazzino cloud (Fase 2A specifica, NON pubblicare ora):
//   → firestore.rules.cloud-warehouse.proposal
// Specifica: docs/fase-2a-modello-dati.md

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Profili creati/aggiornati solo da amministratori (Console / futuro backend Admin).
    // Il client può solo LEGGERE il proprio documento.
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // Magazzino cloud non ancora in uso: deny totale su brands/**.
    match /brands/{brandId}/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
